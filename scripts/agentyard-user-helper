#!/usr/bin/env sh
set -eu
umask 077

control_user=${AGENTYARD_CONTROL_USER:-minder}
agent_group=${AGENTYARD_AGENT_GROUP:-agentyard-agents}

usage() {
  printf 'Usage: %s create|delete|enable-linger|run-as <agent> [command...]\n' "$0" >&2
  exit 1
}

valid_agent() {
  case "$1" in
    *[!a-z0-9-]* | "" | -* | *- | "$control_user") return 1 ;;
    *) return 0 ;;
  esac
}

ensure_subid_range() {
  user_name="$1"
  file_path="$2"
  map_path="$3"
  replace_existing=${4:-0}
  range_size=65536
  map_count=$(awk '$1 == 0 { print $3; exit }' "$map_path" 2>/dev/null || true)
  case "$map_count" in
    "" | *[!0-9]*) map_count=4294967295 ;;
  esac

  [ -f "$file_path" ] || : >"$file_path"

  if [ "$replace_existing" = "1" ]; then
    remove_subid_range "$user_name" "$file_path"
  fi

  if grep -q "^$user_name:" "$file_path" 2>/dev/null; then
    return 0
  fi

  if [ "$map_count" -lt "$range_size" ]; then
    printf 'Not enough user-namespace id space for rootless Docker: %s only maps %s IDs.\n' "$map_path" "$map_count" >&2
    exit 1
  fi

  max_start=$((map_count - range_size))
  start_id=100000
  if [ "$start_id" -gt "$max_start" ]; then
    start_id=$max_start
  fi

  candidate=$start_id
  while [ "$candidate" -le "$max_start" ]; do
    if ! subid_range_in_use "$user_name" "$file_path" "$candidate" "$range_size"; then
      set_subid_range "$user_name" "$file_path" "$candidate" "$range_size"
      return 0
    fi
    candidate=$((candidate + range_size))
  done

  candidate=65536
  while [ "$candidate" -le "$max_start" ]; do
    if ! subid_range_in_use "$user_name" "$file_path" "$candidate" "$range_size"; then
      set_subid_range "$user_name" "$file_path" "$candidate" "$range_size"
      return 0
    fi
    candidate=$((candidate + range_size))
  done

  printf 'No free subordinate id range remains in %s for %s. Increase the LXC idmap or remove unused agent ranges.\n' "$file_path" "$user_name" >&2
  exit 1
}

subid_range_in_use() {
  user_name="$1"
  file_path="$2"
  candidate_start="$3"
  candidate_count="$4"
  candidate_end=$((candidate_start + candidate_count))

  while IFS=: read -r existing_user existing_start existing_count _; do
    [ -n "$existing_user" ] || continue
    [ "$existing_user" != "$user_name" ] || continue
    [ "$existing_user" != root ] || continue
    case "$existing_start:$existing_count" in
      *[!0-9:]* | :* | *:) continue ;;
    esac
    existing_end=$((existing_start + existing_count))
    if [ "$candidate_start" -lt "$existing_end" ] && [ "$candidate_end" -gt "$existing_start" ]; then
      return 0
    fi
  done <"$file_path"

  return 1
}

set_subid_range() {
  user_name="$1"
  file_path="$2"
  start_id="$3"
  range_size="$4"
  printf '%s:%s:%s\n' "$user_name" "$start_id" "$range_size" >>"$file_path"
}

remove_subid_range() {
  user_name="$1"
  file_path="$2"
  tmp_file="$file_path.agentyard.$$"
  [ -f "$file_path" ] || return 0
  grep -v "^$user_name:" "$file_path" >"$tmp_file" || true
  mv "$tmp_file" "$file_path"
}

harden_user_home() {
  user_name="$1"
  home_dir=$(getent passwd "$user_name" | cut -d: -f6)
  [ -n "$home_dir" ] || return 0
  [ -d "$home_dir" ] || return 0
  chmod go-rwx "$home_dir"
}

ensure_agent_runtime() {
  user_name="$1"
  replace_existing=${2:-0}
  harden_user_home "$user_name"
  ensure_subid_range "$user_name" /etc/subuid /proc/self/uid_map "$replace_existing"
  ensure_subid_range "$user_name" /etc/subgid /proc/self/gid_map "$replace_existing"
  loginctl enable-linger "$user_name"
}

remove_agent_runtime() {
  user_name="$1"
  loginctl disable-linger "$user_name" 2>/dev/null || true
  remove_subid_range "$user_name" /etc/subuid
  remove_subid_range "$user_name" /etc/subgid
}

[ "$(id -u)" -eq 0 ] || { printf 'agentyard-user-helper must run as root.\n' >&2; exit 1; }
[ "$#" -ge 2 ] || usage

action="$1"
agent="$2"
shift 2

valid_agent "$agent" || { printf 'Invalid agent name: %s\n' "$agent" >&2; exit 1; }

case "$action" in
  create)
    created_agent=0
    if ! getent group "$agent_group" >/dev/null 2>&1; then
      groupadd --system "$agent_group"
    fi
    if ! id "$agent" >/dev/null 2>&1; then
      useradd --create-home --shell /bin/bash --groups "$agent_group" "$agent"
      passwd -l "$agent" >/dev/null 2>&1 || true
      created_agent=1
    fi
    ensure_agent_runtime "$agent" "$created_agent"
    ;;
  delete)
    remove_agent_runtime "$agent"
    if id "$agent" >/dev/null 2>&1; then
      loginctl terminate-user "$agent" 2>/dev/null || true
      sleep 1
      if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -u "$agent" 2>/dev/null || true
        sleep 2
        pkill -KILL -u "$agent" 2>/dev/null || true
      fi
      userdel --remove "$agent"
    fi
    ;;
  enable-linger)
    ensure_agent_runtime "$agent"
    ;;
  run-as)
    [ "$#" -gt 0 ] || usage
    uid=$(id -u "$agent")
    export XDG_RUNTIME_DIR="/run/user/$uid"
    umask 077
    exec runuser -u "$agent" -- "$@"
    ;;
  *)
    usage
    ;;
esac
