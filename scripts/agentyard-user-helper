#!/usr/bin/env sh
set -eu
umask 077

control_user=${AGENTYARD_CONTROL_USER:-minder}
agent_group=${AGENTYARD_AGENT_GROUP:-agentyard-agents}

usage() {
  printf 'Usage: %s create|delete|enable-linger|run-as <agent> [command...]\n' "$0" >&2
  exit 1
}

valid_agent() {
  case "$1" in
    *[!a-z0-9-]* | "" | -* | *- | "$control_user") return 1 ;;
    *) return 0 ;;
  esac
}

harden_user_home() {
  user_name="$1"
  home_dir=$(getent passwd "$user_name" | cut -d: -f6)
  [ -n "$home_dir" ] || return 0
  [ -d "$home_dir" ] || return 0
  chmod go-rwx "$home_dir"
}

ensure_agent_runtime() {
  user_name="$1"
  harden_user_home "$user_name"
  loginctl enable-linger "$user_name"
}

remove_agent_runtime() {
  user_name="$1"
  loginctl disable-linger "$user_name" 2>/dev/null || true
}

[ "$(id -u)" -eq 0 ] || { printf 'agentyard-user-helper must run as root.\n' >&2; exit 1; }
[ "$#" -ge 2 ] || usage

action="$1"
agent="$2"
shift 2

valid_agent "$agent" || { printf 'Invalid agent name: %s\n' "$agent" >&2; exit 1; }

case "$action" in
  create)
    created_agent=0
    if ! getent group "$agent_group" >/dev/null 2>&1; then
      groupadd --system "$agent_group"
    fi
    if ! id "$agent" >/dev/null 2>&1; then
      useradd --create-home --shell /bin/bash --groups "$agent_group" "$agent"
      passwd -l "$agent" >/dev/null 2>&1 || true
      created_agent=1
    fi
    ensure_agent_runtime "$agent"
    ;;
  delete)
    remove_agent_runtime "$agent"
    if id "$agent" >/dev/null 2>&1; then
      loginctl terminate-user "$agent" 2>/dev/null || true
      sleep 1
      if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -u "$agent" 2>/dev/null || true
        sleep 2
        pkill -KILL -u "$agent" 2>/dev/null || true
      fi
      userdel --remove "$agent"
    fi
    ;;
  enable-linger)
    ensure_agent_runtime "$agent"
    ;;
  run-as)
    [ "$#" -gt 0 ] || usage
    uid=$(id -u "$agent")
    export XDG_RUNTIME_DIR="/run/user/$uid"
    umask 077
    exec runuser -u "$agent" -- "$@"
    ;;
  *)
    usage
    ;;
esac
