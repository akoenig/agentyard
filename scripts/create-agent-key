#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *-)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, and cannot start/end with a hyphen.\n' >&2
    exit 1
    ;;
esac

agent_env=$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')
master_var="LITELLM_${agent_env}_MASTER_KEY"
hermes_key_var="HERMES_${agent_env}_LITELLM_KEY"
litellm_service="$agent-litellm"
agent_compose="agents/$agent/config/compose.yaml"

[ -f .env ] || { printf '.env does not exist.\n' >&2; exit 1; }
set -a
. ./.env
set +a

eval "master_key=\${$master_var:-}"
[ -n "$master_key" ] || { printf 'Missing %s in .env.\n' "$master_var" >&2; exit 1; }
[ -f "$agent_compose" ] || { printf 'Missing %s. Create the agent first.\n' "$agent_compose" >&2; exit 1; }

payload='{"key_alias":"'"$agent"'-hermes","models":["chatgpt/gpt-5.5","chatgpt/gpt-5.5-pro","chatgpt/gpt-5.4","chatgpt/gpt-5.4-pro","chatgpt/gpt-5.3-codex","chatgpt/gpt-5.3-codex-spark","chatgpt/gpt-5.3-instant","chatgpt/gpt-5.3-chat-latest"],"metadata":{"owner":"agent:'"$agent"'","type":"hermes-agent"}}'

command -v docker >/dev/null 2>&1 || { printf 'docker is required to generate a key for private LiteLLM.\n' >&2; exit 1; }

printf 'Generating LiteLLM key via http://%s:4000/key/generate inside Docker.\n' "$litellm_service"
response=$(docker compose -f compose.yaml -f "$agent_compose" exec -T \
  -e MASTER_KEY="$master_key" \
  -e PAYLOAD="$payload" \
  "$litellm_service" python - <<'PY'
import os
import sys
import urllib.error
import urllib.request

request = urllib.request.Request(
    "http://127.0.0.1:4000/key/generate",
    data=os.environ["PAYLOAD"].encode(),
    headers={
        "Authorization": f"Bearer {os.environ['MASTER_KEY']}",
        "Content-Type": "application/json",
    },
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=60) as response:
        sys.stdout.write(response.read().decode())
except urllib.error.HTTPError as error:
    sys.stderr.write(f"LiteLLM key generation failed with HTTP {error.code}.\n")
    sys.stderr.write(error.read().decode())
    sys.stderr.write("\n")
    sys.exit(1)
PY
)

key=$(RESPONSE="$response" python3 - <<'PY'
import json
import os
import re
import sys

raw = os.environ["RESPONSE"]
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    print(raw, file=sys.stderr)
    sys.exit(1)

for field in ("key", "token"):
    value = data.get(field)
    if isinstance(value, str) and value.startswith("sk-"):
        print(value)
        sys.exit(0)

match = re.search(r"sk-[A-Za-z0-9_\-]+", raw)
if match:
    print(match.group(0))
    sys.exit(0)

print(raw, file=sys.stderr)
sys.exit(1)
PY
)

tmp_file=".env.tmp.$$"
if grep -q "^$hermes_key_var=" .env; then
  sed "s|^$hermes_key_var=.*|$hermes_key_var=$key|" .env >"$tmp_file"
else
  cp .env "$tmp_file"
  printf '%s=%s\n' "$hermes_key_var" "$key" >>"$tmp_file"
fi
mv "$tmp_file" .env
chmod go-rwx .env*

if ! grep -q "^$hermes_key_var=sk-" .env; then
  printf 'Failed to write %s to .env.\n' "$hermes_key_var" >&2
  exit 1
fi

printf 'Stored %s in .env.\n' "$hermes_key_var"
printf 'Next: docker compose -f compose.yaml -f agents/%s/config/compose.yaml up -d --force-recreate %s %s\n' "$agent" "$agent-hermes" "$agent-hermes-webui"
