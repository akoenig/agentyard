#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *- | _*)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, cannot start/end with a hyphen, and cannot start with underscore.\n' >&2
    exit 1
    ;;
esac

agent_dir="agents/$agent"
if [ ! -d "$agent_dir" ]; then
  printf 'Agent does not exist: %s\n' "$agent" >&2
  exit 1
fi

agent_env=$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')
webui_service="$agent-hermes-webui"
agent_service="$agent-hermes-agent"
webui_password_var="HERMES_${agent_env}_WEBUI_PASSWORD"
telegram_bot_token_var="HERMES_${agent_env}_TELEGRAM_BOT_TOKEN"
telegram_allowed_users_var="HERMES_${agent_env}_TELEGRAM_ALLOWED_USERS"
telegram_home_channel_var="HERMES_${agent_env}_TELEGRAM_HOME_CHANNEL"
telegram_home_channel_name_var="HERMES_${agent_env}_TELEGRAM_HOME_CHANNEL_NAME"

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

agent_network="${COMPOSE_PROJECT_NAME:-agents}-$agent"

if command -v docker >/dev/null 2>&1; then
  docker compose -f compose.yaml -f "$agent_dir/config/compose.yaml" stop "$webui_service" "$agent_service" 2>/dev/null || true
  docker compose -f compose.yaml -f "$agent_dir/config/compose.yaml" rm -f "$webui_service" "$agent_service" 2>/dev/null || true
  docker network rm "$agent_network" 2>/dev/null || true
fi

rm -rf "$agent_dir"

if [ -f .env ]; then
  tmp_file=".env.tmp.$$"
  grep -v -e "^# Agent: $agent$" \
    -e "^$webui_password_var=" \
    -e "^$telegram_bot_token_var=" \
    -e "^$telegram_allowed_users_var=" \
    -e "^$telegram_home_channel_var=" \
    -e "^$telegram_home_channel_name_var=" .env >"$tmp_file" || true
  mv "$tmp_file" .env
  chmod go-rwx .env*
fi

printf 'Deleted agent %s.\n' "$agent"
