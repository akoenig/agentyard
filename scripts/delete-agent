#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *- | minder)
    printf 'Invalid agent name: %s\n' "$agent" >&2
    exit 1
    ;;
esac

control_user=${AGENTYARD_CONTROL_USER:-minder}
helper=${AGENTYARD_HELPER:-/usr/local/sbin/agentyard-user}

[ "$(id -u)" -ne 0 ] || { printf 'Run this script as %s, not root.\n' "$control_user" >&2; exit 1; }
[ "$(id -un)" = "$control_user" ] || { printf 'Run this script as %s. Current user: %s\n' "$control_user" "$(id -un)" >&2; exit 1; }

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

agent_dir="agents/$agent"
[ -d "$agent_dir" ] || { printf 'Agent does not exist: %s\n' "$agent" >&2; exit 1; }
[ -x "$helper" ] || { printf 'Missing helper %s.\n' "$helper" >&2; exit 1; }

if id "$agent" >/dev/null 2>&1; then
  sudo "$helper" run-as "$agent" systemctl --user disable --now agentyard-webui.service 2>/dev/null || true
  sudo "$helper" run-as "$agent" systemctl --user disable --now agentyard-gateway.service 2>/dev/null || true
  sudo "$helper" delete "$agent"
fi

rm -rf "$agent_dir"

printf 'Deleted agent %s.\n' "$agent"
