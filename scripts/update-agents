#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s\n' "$0" >&2
  exit 1
}

[ "$#" -eq 0 ] || usage

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

if [ ! -d agents ]; then
  exit 0
fi

updated=0
for agent_dir in agents/*; do
  [ -d "$agent_dir" ] || exit 0
  [ -f "$agent_dir/agent.env" ] || continue
  agent=$(basename "$agent_dir")
  "$repo_dir/scripts/update-agent" "$agent"
  updated=$((updated + 1))
done

printf 'Updated %s agent(s).\n' "$updated"
