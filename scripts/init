#!/usr/bin/env sh
set -eu

control_user=${AGENTYARD_CONTROL_USER:-minder}
helper=${AGENTYARD_HELPER:-/usr/local/sbin/agentyard-user}

[ "$(id -u)" -ne 0 ] || { printf 'Run this script as %s, not root.\n' "$control_user" >&2; exit 1; }
[ "$(id -un)" = "$control_user" ] || { printf 'Run this script as %s. Current user: %s\n' "$control_user" "$(id -un)" >&2; exit 1; }

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

if [ ! -f .env ]; then
  cp .env.example .env
  chmod go-rwx .env
fi

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

read_from_tty() {
  prompt="$1"
  printf '%s' "$prompt" >/dev/tty
  IFS= read -r reply </dev/tty
  printf '%s' "$reply"
}

prompt_if_empty() {
  var_name="$1"
  prompt="$2"
  current_value=$(eval "printf '%s' \"\${$var_name:-}\"")
  if [ -z "$current_value" ]; then
    new_value=$(read_from_tty "$prompt: ")
    set_env_value "$var_name" "$new_value"
    eval "$var_name=\$new_value"
  fi
}

set_env_value() {
  var_name="$1"
  var_value="$2"
  tmp_file=".env.tmp.$$"
  if [ -f .env ]; then
    grep -v -e "^$var_name=" .env >"$tmp_file" || true
    mv "$tmp_file" .env
  fi
  printf '%s=%s\n' "$var_name" "$var_value" >>.env
  chmod go-rwx .env
}

is_cloudflare_tunnel_token() {
  case "$1" in
    "" | *[[:space:]]*) return 1 ;;
    *.*.*) return 0 ;;
    eyJ*) return 0 ;;
    [A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*) return 0 ;;
    *) return 1 ;;
  esac
}

extract_cloudflare_tunnel_token() {
  previous_word=
  for word in $1; do
    word=${word#\"}
    word=${word%\"}
    word=${word#'}
    word=${word%'}
    case "$previous_word" in
      --token | install)
        if is_cloudflare_tunnel_token "$word"; then
          printf '%s' "$word"
          return 0
        fi
        ;;
    esac
    previous_word=$word
  done

  for word in $1; do
    word=${word#\"}
    word=${word%\"}
    word=${word#'}
    word=${word%'}
    case "$word" in
      cloudflared | sudo | service | install | tunnel | run | --token | http:* | https:*) continue ;;
    esac
    if is_cloudflare_tunnel_token "$word"; then
      printf '%s' "$word"
      return 0
    fi
  done
  return 1
}

prompt_if_empty AGENT_BASE_DOMAIN 'Base domain for agent hostnames (example: example.com)'
if [ -z "${AGENT_BASE_PORT:-}" ]; then
  set_env_value AGENT_BASE_PORT 8787
  AGENT_BASE_PORT=8787
fi

if [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  extracted_token=$(extract_cloudflare_tunnel_token "$CLOUDFLARE_TUNNEL_TOKEN" || true)
  if [ -n "$extracted_token" ]; then
    CLOUDFLARE_TUNNEL_TOKEN=$extracted_token
    set_env_value CLOUDFLARE_TUNNEL_TOKEN "$CLOUDFLARE_TUNNEL_TOKEN"
  else
    printf 'Ignoring invalid CLOUDFLARE_TUNNEL_TOKEN value in .env. It should be the JWT tunnel token, not a domain.\n'
    set_env_value CLOUDFLARE_TUNNEL_TOKEN ""
    CLOUDFLARE_TUNNEL_TOKEN=
  fi
fi

if [ -z "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  tunnel_token=$(read_from_tty 'Cloudflare Tunnel token (JWT from Cloudflare, not your domain; leave empty to configure manually): ')
  if [ -n "$tunnel_token" ]; then
    extracted_token=$(extract_cloudflare_tunnel_token "$tunnel_token" || true)
    if [ -n "$extracted_token" ]; then
        set_env_value CLOUDFLARE_TUNNEL_TOKEN "$extracted_token"
        CLOUDFLARE_TUNNEL_TOKEN=$extracted_token
    else
        printf 'That does not look like a Cloudflare Tunnel token. Skipping cloudflared service setup.\n'
        CLOUDFLARE_TUNNEL_TOKEN=
    fi
  fi
fi

mkdir -p agents "$HOME/.config/systemd/user" "$HOME/.cloudflared"

[ -x "$helper" ] || { printf 'Missing helper %s. Run sudo ./agentyard install-control-plane first.\n' "$helper" >&2; exit 1; }

if [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  if command -v cloudflared >/dev/null 2>&1; then
    cloudflared_path=$(command -v cloudflared)
    cloudflared_unit="$HOME/.config/systemd/user/agentyard-cloudflared.service"
    cat >"$cloudflared_unit" <<EOF
[Unit]
Description=Agentyard Cloudflare Tunnel
After=network-online.target

[Service]
Type=simple
ExecStart=$cloudflared_path tunnel run --token $CLOUDFLARE_TUNNEL_TOKEN
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable agentyard-cloudflared.service
    systemctl --user start --no-block agentyard-cloudflared.service
    printf 'Cloudflare Tunnel service installed: %s\n' "$cloudflared_unit"
  else
    printf 'cloudflared is not installed. Install it, then rerun agentyard init to create the tunnel service.\n'
  fi
else
  printf 'No Cloudflare Tunnel token configured; skipping cloudflared service setup.\n'
fi

printf '\nAgentyard control plane is ready. Create an agent with:\n'
printf '  agentyard create <agent-name>\n'
