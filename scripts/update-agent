#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
helper=${AGENTYARD_HELPER:-/usr/local/sbin/agentyard-user}
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

agent_env="agents/$agent/agent.env"
[ -f "$agent_env" ] || { printf 'Agent does not exist: %s\n' "$agent" >&2; exit 1; }
. "$agent_env"

[ -x "$helper" ] || { printf 'Missing helper %s.\n' "$helper" >&2; exit 1; }

printf 'Updating Hermes Agent and WebUI for %s.\n' "$agent"
sudo "$helper" run-as "$SYSTEM_USER" sh -lc "set -eu; PATH=\"\$HOME/.local/bin:\$PATH\"; hermes update || true; git -C \"$WEBUI_DIR\" pull --ff-only; python3 -m venv \"$WEBUI_DIR/.venv\"; \"$WEBUI_DIR/.venv/bin/python\" -m pip install --upgrade pip >/dev/null; \"$WEBUI_DIR/.venv/bin/python\" -m pip install -r \"$WEBUI_DIR/requirements.txt\""
sudo "$helper" enable-linger "$SYSTEM_USER"
sudo "$helper" run-as "$SYSTEM_USER" sh -lc "set -eu; PATH=\"\$HOME/.local/bin:\$PATH\"; export HERMES_HOME=\"$HERMES_PROFILE\"; systemctl --user daemon-reload; if ! systemctl --user cat hermes-gateway.service >/dev/null 2>&1; then hermes gateway install; systemctl --user daemon-reload; fi; systemctl --user enable hermes-gateway.service >/dev/null 2>&1 || true; hermes gateway restart || hermes gateway start"
sudo "$helper" run-as "$SYSTEM_USER" systemctl --user restart agentyard-webui.service

printf 'Updated agent %s.\n' "$agent"
