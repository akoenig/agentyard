#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *-)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, and cannot start/end with a hyphen.\n' >&2
    exit 1
    ;;
esac

agent_env=$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

agent_base_domain=${AGENT_BASE_DOMAIN:-example.com}
webui_service="$agent-hermes-webui"
agent_service="$agent-hermes-agent"
agent_network="$agent-network"
webui_password_var="HERMES_${agent_env}_WEBUI_PASSWORD"
webui_host="$agent.$agent_base_domain"

if [ -d "agents/$agent" ]; then
  printf 'Agent already exists: %s\n' "$agent" >&2
  exit 1
fi

command -v docker >/dev/null 2>&1 || {
  printf 'docker is required to create an agent and complete Codex login.\n' >&2
  exit 1
}
command -v git >/dev/null 2>&1 || {
  printf 'git is required to clone Hermes Agent source.\n' >&2
  exit 1
}

hermes_agent_repo=${HERMES_AGENT_REPO:-https://github.com/NousResearch/hermes-agent.git}
hermes_agent_ref=${HERMES_AGENT_REF:-main}
hermes_webui_image=${HERMES_WEBUI_IMAGE:-ghcr.io/nesquena/hermes-webui:latest}
hermes_agent_image=${HERMES_AGENT_IMAGE:-nousresearch/hermes-agent:latest}

mkdir -p \
  "agents/$agent/config" \
  "agents/$agent/data/hermes" \
  "agents/$agent/data/hermes/profiles/$agent" \
  "agents/$agent/data/hermes/profiles/$agent/cron" \
  "agents/$agent/data/hermes/profiles/$agent/home" \
  "agents/$agent/data/hermes/profiles/$agent/logs" \
  "agents/$agent/data/hermes/profiles/$agent/memories" \
  "agents/$agent/data/hermes/profiles/$agent/plans" \
  "agents/$agent/data/hermes/profiles/$agent/sessions" \
  "agents/$agent/data/hermes/profiles/$agent/skills" \
  "agents/$agent/data/hermes/profiles/$agent/skins" \
  "agents/$agent/data/hermes/profiles/$agent/workspace" \
  "agents/$agent/data/hermes/webui/extensions" \
  "agents/$agent/data/workspace"
touch \
  "agents/$agent/data/.gitkeep" \
  "agents/$agent/data/hermes/.gitkeep" \
  "agents/$agent/data/hermes/profiles/$agent/.gitkeep" \
  "agents/$agent/data/workspace/.gitkeep"

container_uid=${UID:-1000}
container_gid=${GID:-1000}
chown -R "$container_uid:$container_gid" "agents/$agent/data" 2>/dev/null || true

printf 'Cloning Hermes Agent source (%s @ %s).\n' "$hermes_agent_repo" "$hermes_agent_ref"
git clone "$hermes_agent_repo" "agents/$agent/data/hermes/hermes-agent"
git -C "agents/$agent/data/hermes/hermes-agent" checkout "$hermes_agent_ref"
chown -R "$container_uid:$container_gid" "agents/$agent/data/hermes/hermes-agent" 2>/dev/null || true

printf '%s\n' "$agent" >"agents/$agent/data/hermes/active_profile"

cat >"agents/$agent/data/hermes/profiles/$agent/config.yaml" <<EOF
model:
  provider: openai-codex
  default: gpt-5.5
terminal:
  backend: local
  cwd: /workspace
EOF

cat >"agents/$agent/data/hermes/webui/settings.json" <<EOF
{
  "onboarding_completed": true,
  "sound_enabled": true,
  "notifications_enabled": true,
  "show_token_usage": true
}
EOF

cat >"agents/$agent/data/hermes/webui/extensions/default-preferences.js" <<'EOF'
(function () {
  const defaults = {
    'hermes-tts-enabled': 'true',
    'hermes-voice-mode-button': 'true'
  };

  for (const [key, value] of Object.entries(defaults)) {
    if (localStorage.getItem(key) === null) {
      localStorage.setItem(key, value);
    }
  }

  if (typeof window._applyTtsEnabled === 'function') {
    window._applyTtsEnabled(localStorage.getItem('hermes-tts-enabled') === 'true');
  }
  if (typeof window._applyVoiceModePref === 'function') {
    window._applyVoiceModePref();
  }

  let cronSince = Date.now() / 1000;
  async function pollCronCompletions() {
    try {
      const res = await fetch(`/api/crons/recent?since=${encodeURIComponent(cronSince)}`, {
        credentials: 'same-origin'
      });
      if (!res.ok) return;
      const data = await res.json();
      const completions = Array.isArray(data.completions) ? data.completions : [];
      for (const completion of completions) {
        const completedAt = Number(completion.completed_at || 0);
        if (completedAt > cronSince) cronSince = completedAt;
        const failed = completion.status === 'error';
        const title = failed ? 'Hermes reminder failed' : 'Hermes reminder completed';
        const body = completion.name || 'Scheduled job completed';
        if (typeof window.showToast === 'function' && !document.hidden) {
          window.showToast(`${title}: ${body}`, 4000, failed ? 'error' : 'success');
        }
        if (typeof window.playNotificationSound === 'function') {
          window.playNotificationSound();
        }
        if (typeof window.sendBrowserNotification === 'function') {
          window.sendBrowserNotification(title, body);
        }
      }
    } catch (_) {
      // Best-effort browser reminder surface; cron execution is server-side.
    }
  }

  setInterval(pollCronCompletions, 30000);
})();
EOF

cat >"agents/$agent/config/compose.yaml" <<EOF
services:
  $agent_service:
    image: \${HERMES_AGENT_IMAGE:-$hermes_agent_image}
    container_name: $agent_service
    command: gateway run
    restart: unless-stopped
    environment:
      HERMES_HOME: /home/hermes/.hermes/profiles/$agent
      HERMES_INFERENCE_PROVIDER: openai-codex
      HERMES_INFERENCE_MODEL: gpt-5.5
      HERMES_UID: \${UID:-1000}
      HERMES_GID: \${GID:-1000}
    volumes:
      - ./agents/$agent/data/hermes:/home/hermes/.hermes
      - ./agents/$agent/data/workspace:/workspace
    networks:
      - $agent_network

  $webui_service:
    image: \${HERMES_WEBUI_IMAGE:-$hermes_webui_image}
    container_name: $webui_service
    depends_on:
      - $agent_service
    restart: unless-stopped
    expose:
      - "8787"
    environment:
      HERMES_WEBUI_HOST: 0.0.0.0
      HERMES_WEBUI_PORT: "8787"
      HERMES_WEBUI_PASSWORD: \${$webui_password_var}
      HERMES_HOME: /home/hermeswebui/.hermes
      HERMES_WEBUI_STATE_DIR: /home/hermeswebui/.hermes/webui
      HERMES_WEBUI_DEFAULT_WORKSPACE: /workspace
      HERMES_WEBUI_SKIP_ONBOARDING: "1"
      HERMES_WEBUI_EXTENSION_DIR: /home/hermeswebui/.hermes/webui/extensions
      HERMES_WEBUI_EXTENSION_SCRIPT_URLS: /extensions/default-preferences.js
      HERMES_INFERENCE_PROVIDER: openai-codex
      HERMES_INFERENCE_MODEL: gpt-5.5
      HERMES_EXEC_ASK: "1"
      WANTED_UID: \${UID:-1000}
      WANTED_GID: \${GID:-1000}
    volumes:
      - ./agents/$agent/data/hermes:/home/hermeswebui/.hermes
      - ./agents/$agent/data/workspace:/workspace
    networks:
      - tunnel
      - $agent_network

networks:
  $agent_network:
    name: \${COMPOSE_PROJECT_NAME:-agents}-$agent
EOF

touch .env
chmod go-rwx .env*
if ! grep -q "^$webui_password_var=" .env; then
  {
    printf '\n# Agent: %s\n' "$agent"
    printf '%s=\n' "$webui_password_var"
  } >>.env
  chmod go-rwx .env*
fi

printf 'Created agent %s.\n' "$agent"
printf 'WebUI URL: https://%s\n' "$webui_host"
printf 'Cloudflare Tunnel service: http://%s:8787\n' "$webui_service"
printf '\nStarting OpenAI Codex login. Open the shown URL, enter the code, and approve the ChatGPT subscription login.\n'

docker run -it --rm \
  -e HERMES_HOME=/opt/data/profiles/$agent \
  -e HERMES_INFERENCE_PROVIDER=openai-codex \
  -e HERMES_INFERENCE_MODEL=gpt-5.5 \
  -e HERMES_UID="$container_uid" \
  -e HERMES_GID="$container_gid" \
  -v "$(pwd)/agents/$agent/data/hermes:/opt/data" \
  -v "$(pwd)/agents/$agent/data/workspace:/workspace" \
  "$hermes_agent_image" auth add openai-codex --type oauth

printf '\nStarting shared tunnel and %s.\n' "$webui_service"
docker compose -f compose.yaml -f "agents/$agent/config/compose.yaml" up -d cloudflared "$agent_service" "$webui_service"

printf '\nAgent %s is ready.\n' "$agent"
printf 'Open: https://%s\n' "$webui_host"
