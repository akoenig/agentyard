#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *-)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, and cannot start/end with a hyphen.\n' >&2
    exit 1
    ;;
esac

agent_env=$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
agent_base_domain=${AGENT_BASE_DOMAIN:-example.com}
db_name="litellm_$(printf '%s' "$agent" | tr '-' '_')"
litellm_service="$agent-litellm"
hermes_service="$agent-hermes"
webui_service="$agent-hermes-webui"
agent_network="$agent-agent"
agent_src_volume="$agent-hermes-agent-src"
litellm_master_var="LITELLM_${agent_env}_MASTER_KEY"
litellm_salt_var="LITELLM_${agent_env}_SALT_KEY"
hermes_key_var="HERMES_${agent_env}_LITELLM_KEY"
hermes_api_key_var="HERMES_${agent_env}_API_SERVER_KEY"
webui_password_var="HERMES_${agent_env}_WEBUI_PASSWORD"
webui_host="$agent.$agent_base_domain"

if [ -d "agents/$agent" ]; then
  printf 'Agent already exists: %s\n' "$agent" >&2
  exit 1
fi

random_key() {
  if command -v openssl >/dev/null 2>&1; then
    printf 'sk-%s' "$(openssl rand -hex 24)"
  else
    printf 'sk-%s' "$(LC_ALL=C tr -dc 'a-zA-Z0-9' </dev/urandom | dd bs=48 count=1 2>/dev/null)"
  fi
}

mkdir -p \
  "agents/$agent/config" \
  "agents/$agent/data/hermes" \
  "agents/$agent/data/litellm" \
  "agents/$agent/data/webui" \
  "agents/$agent/data/workspace"
touch \
  "agents/$agent/data/.gitkeep" \
  "agents/$agent/data/hermes/.gitkeep" \
  "agents/$agent/data/litellm/.gitkeep" \
  "agents/$agent/data/webui/.gitkeep" \
  "agents/$agent/data/workspace/.gitkeep"

cp config/litellm/models.chatgpt.yaml "agents/$agent/config/litellm.yaml"
cat >>"agents/$agent/config/litellm.yaml" <<EOF

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
EOF

cat >"agents/$agent/config/compose.yaml" <<EOF
services:
  $litellm_service:
    image: ghcr.io/berriai/litellm-database:main-stable
    container_name: $litellm_service
    restart: unless-stopped
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    depends_on:
      postgres:
        condition: service_healthy
    expose:
      - "4000"
    environment:
      DATABASE_URL: postgresql://\${POSTGRES_USER}:\${POSTGRES_PASSWORD}@postgres:5432/$db_name
      LITELLM_MASTER_KEY: \${$litellm_master_var}
      LITELLM_SALT_KEY: \${$litellm_salt_var}
      CHATGPT_TOKEN_DIR: /data/chatgpt
    volumes:
      - ./agents/$agent/config/litellm.yaml:/app/config.yaml:ro
      - ./agents/$agent/data/litellm:/data
    networks:
      - $agent_network
      - db
      - egress

  $hermes_service:
    image: nousresearch/hermes-agent:latest
    container_name: $hermes_service
    restart: unless-stopped
    command: gateway run
    depends_on:
      - $litellm_service
    expose:
      - "8642"
    environment:
      HERMES_HOME: /opt/data
      HERMES_UID: \${UID:-1000}
      HERMES_GID: \${GID:-1000}
      OPENAI_BASE_URL: http://$litellm_service:4000/v1
      OPENAI_API_KEY: \${$hermes_key_var:-}
      API_SERVER_ENABLED: "true"
      API_SERVER_HOST: 0.0.0.0
      API_SERVER_PORT: "8642"
      API_SERVER_KEY: \${$hermes_api_key_var}
    volumes:
      - ./agents/$agent/data/hermes:/opt/data
      - $agent_src_volume:/opt/hermes
    shm_size: 1g
    networks:
      - $agent_network
      - egress

  $webui_service:
    image: ghcr.io/nesquena/hermes-webui:latest
    container_name: $webui_service
    restart: unless-stopped
    depends_on:
      - $hermes_service
    expose:
      - "8787"
    environment:
      HERMES_WEBUI_HOST: 0.0.0.0
      HERMES_WEBUI_PORT: "8787"
      HERMES_WEBUI_PASSWORD: \${$webui_password_var}
      HERMES_HOME: /home/hermeswebui/.hermes
      HERMES_WEBUI_AGENT_DIR: /home/hermeswebui/.hermes/hermes-agent
      HERMES_WEBUI_STATE_DIR: /home/hermeswebui/webui-state
      HERMES_WEBUI_DEFAULT_WORKSPACE: /workspace
      OPENAI_BASE_URL: http://$litellm_service:4000/v1
      OPENAI_API_KEY: \${$hermes_key_var:-}
      WANTED_UID: \${UID:-1000}
      WANTED_GID: \${GID:-1000}
    volumes:
      - ./agents/$agent/data/hermes:/home/hermeswebui/.hermes
      - $agent_src_volume:/home/hermeswebui/.hermes/hermes-agent
      - ./agents/$agent/data/webui:/home/hermeswebui/webui-state
      - ./agents/$agent/data/workspace:/workspace
    networks:
      - $agent_network
      - tunnel
      - egress

networks:
  $agent_network:
    internal: true

volumes:
  $agent_src_volume:
EOF

touch .env
chmod go-rwx .env*
if ! grep -q "^$litellm_master_var=" .env; then
  {
    printf '\n# Agent: %s\n' "$agent"
    printf '%s=%s\n' "$litellm_master_var" "$(random_key)"
    printf '%s=%s\n' "$litellm_salt_var" "$(random_key)"
    printf '%s=\n' "$hermes_key_var"
    printf '%s=%s\n' "$hermes_api_key_var" "$(random_key)"
    printf '%s=%s\n' "$webui_password_var" "$(random_key)"
  } >>.env
  chmod go-rwx .env*
fi

set -a
. ./.env
set +a

if command -v docker >/dev/null 2>&1; then
  if docker compose ps postgres >/dev/null 2>&1; then
    docker compose exec -T postgres createdb -U "${POSTGRES_USER:-litellm}" "$db_name" 2>/dev/null || true
  fi
fi

printf 'Created agent %s.\n' "$agent"
printf 'WebUI URL: https://%s\n' "$webui_host"
printf 'Cloudflare Tunnel service: http://%s:8787\n' "$webui_service"
printf 'Next: docker compose -f compose.yaml -f agents/%s/config/compose.yaml up -d postgres cloudflared %s\n' "$agent" "$litellm_service"
