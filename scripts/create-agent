#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *- | minder)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, cannot start/end with a hyphen, and cannot be minder.\n' >&2
    exit 1
    ;;
esac

control_user=${AGENTYARD_CONTROL_USER:-minder}
helper=${AGENTYARD_HELPER:-/usr/local/sbin/agentyard-user}

[ "$(id -u)" -ne 0 ] || { printf 'Run this script as %s, not root.\n' "$control_user" >&2; exit 1; }
[ "$(id -un)" = "$control_user" ] || { printf 'Run this script as %s. Current user: %s\n' "$control_user" "$(id -un)" >&2; exit 1; }

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

[ -x "$helper" ] || { printf 'Missing helper %s. Run sudo ./agentyard install-control-plane first.\n' "$helper" >&2; exit 1; }

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

agent_base_domain=${AGENT_BASE_DOMAIN:-example.com}
base_port=${AGENT_BASE_PORT:-8787}
webui_repo=${HERMES_WEBUI_REPO:-https://github.com/nesquena/hermes-webui.git}
webui_ref=${HERMES_WEBUI_REF:-master}
agent_dir="$repo_dir/agents/$agent"
webui_host="$agent.$agent_base_domain"

[ ! -d "$agent_dir" ] || { printf 'Agent already exists: %s\n' "$agent" >&2; exit 1; }

port=$base_port
while :; do
  in_use=0
  for env_file in agents/*/agent.env; do
    [ -f "$env_file" ] || continue
    existing_port=$(sed -n 's/^PORT=//p' "$env_file" | tail -n 1)
    [ "$existing_port" = "$port" ] && in_use=1
  done
  [ "$in_use" -eq 0 ] && break
  port=$((port + 1))
done

printf 'Creating Linux user %s.\n' "$agent"
sudo "$helper" create "$agent"

agent_home=$(getent passwd "$agent" | cut -d: -f6)
profile_dir="$agent_home/.hermes"
webui_dir="$agent_home/hermes-webui"
workspace_dir="$agent_home/workspace"
unit_dir="$agent_home/.config/systemd/user"

mkdir -p "$agent_dir"
cat >"$agent_dir/agent.env" <<EOF
NAME=$agent
SYSTEM_USER=$agent
HOSTNAME=$webui_host
PORT=$port
AGENT_HOME=$agent_home
WORKSPACE=$workspace_dir
WEBUI_DIR=$webui_dir
HERMES_PROFILE=$profile_dir
EOF

printf 'Installing Hermes Agent and WebUI as %s.\n' "$agent"
sudo "$helper" run-as "$agent" sh -lc "set -eu; cd \"\$HOME\"; PATH=\"\$HOME/.local/bin:\$PATH\"; if ! command -v hermes >/dev/null 2>&1; then curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash; fi; mkdir -p \"$workspace_dir\" \"$unit_dir\"; if [ ! -d \"$webui_dir/.git\" ]; then git clone \"$webui_repo\" \"$webui_dir\"; fi; git -C \"$webui_dir\" fetch origin; git -C \"$webui_dir\" checkout \"$webui_ref\"; python3 -m venv \"$webui_dir/.venv\"; \"$webui_dir/.venv/bin/python\" -m pip install --upgrade pip >/dev/null; \"$webui_dir/.venv/bin/python\" -m pip install -r \"$webui_dir/requirements.txt\""

sudo "$helper" run-as "$agent" sh -lc "cat >\"$profile_dir/config.yaml\" <<'EOF'
terminal:
  backend: local
  cwd: $workspace_dir
EOF
if [ ! -f \"$profile_dir/.env\" ]; then touch \"$profile_dir/.env\"; chmod go-rwx \"$profile_dir/.env\"; fi"

cat >/tmp/agentyard-webui-$agent.service <<EOF
[Unit]
Description=Agentyard WebUI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$webui_dir
Environment=PATH=$agent_home/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_HOME=$profile_dir
Environment=HERMES_WEBUI_STATE_DIR=$agent_home/webui-state
Environment=HERMES_WEBUI_DEFAULT_WORKSPACE=$workspace_dir
Environment=HERMES_WEBUI_HOST=127.0.0.1
Environment=HERMES_WEBUI_PORT=$port
Environment=HERMES_WEBUI_SKIP_ONBOARDING=1
Environment=HERMES_EXEC_ASK=1
ExecStart=$webui_dir/.venv/bin/python $webui_dir/bootstrap.py --no-browser --foreground --host 127.0.0.1 $port
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF

cat >/tmp/agentyard-gateway-$agent.service <<EOF
[Unit]
Description=Agentyard Gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$workspace_dir
Environment=PATH=$agent_home/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_HOME=$profile_dir
ExecStart=$agent_home/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF

sudo "$helper" run-as "$agent" sh -lc "mkdir -p \"$unit_dir\"; cp /tmp/agentyard-webui-$agent.service \"$unit_dir/agentyard-webui.service\"; cp /tmp/agentyard-gateway-$agent.service \"$unit_dir/agentyard-gateway.service\""
rm -f "/tmp/agentyard-webui-$agent.service" "/tmp/agentyard-gateway-$agent.service"

printf 'Starting Hermes setup as %s. Use the wizard to choose and authenticate the provider for this agent.\n' "$agent"
sudo "$helper" run-as "$agent" sh -lc "PATH=\"\$HOME/.local/bin:\$PATH\" hermes setup"

sudo "$helper" run-as "$agent" systemctl --user daemon-reload
sudo "$helper" run-as "$agent" systemctl --user enable --now agentyard-gateway.service
sudo "$helper" run-as "$agent" systemctl --user enable --now agentyard-webui.service

printf '\nAgent %s is ready.\n' "$agent"
printf 'WebUI: https://%s\n' "$webui_host"
printf 'Local service: http://127.0.0.1:%s\n' "$port"
printf '\nCloudflare Tunnel route to add:\n'
printf '  Hostname: %s\n' "$webui_host"
printf '  Service:  http://127.0.0.1:%s\n' "$port"
printf '\nProvider and messaging settings live in %s. Re-run hermes setup as %s to change them.\n' "$profile_dir" "$agent"
