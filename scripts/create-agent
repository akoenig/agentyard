#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <agent-name>\n' "$0" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage

agent="$1"
case "$agent" in
  *[!a-z0-9-]* | "" | -* | *-)
    printf 'Agent name must use lowercase letters, numbers, and hyphens, and cannot start/end with a hyphen.\n' >&2
    exit 1
    ;;
esac

agent_env=$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

agent_base_domain=${AGENT_BASE_DOMAIN:-example.com}
webui_service="$agent-hermes-webui"
webui_password_var="HERMES_${agent_env}_WEBUI_PASSWORD"
webui_host="$agent.$agent_base_domain"

if [ -d "agents/$agent" ]; then
  printf 'Agent already exists: %s\n' "$agent" >&2
  exit 1
fi

command -v docker >/dev/null 2>&1 || {
  printf 'docker is required to create an agent and complete Codex login.\n' >&2
  exit 1
}
command -v git >/dev/null 2>&1 || {
  printf 'git is required to clone Hermes Agent source.\n' >&2
  exit 1
}

hermes_agent_repo=${HERMES_AGENT_REPO:-https://github.com/NousResearch/hermes-agent.git}
hermes_agent_ref=${HERMES_AGENT_REF:-main}
hermes_webui_image=${HERMES_WEBUI_IMAGE:-ghcr.io/nesquena/hermes-webui:latest}
hermes_agent_image=${HERMES_AGENT_IMAGE:-nousresearch/hermes-agent:latest}

mkdir -p \
  "agents/$agent/config" \
  "agents/$agent/data/hermes" \
  "agents/$agent/data/workspace"
touch \
  "agents/$agent/data/.gitkeep" \
  "agents/$agent/data/hermes/.gitkeep" \
  "agents/$agent/data/workspace/.gitkeep"

container_uid=${UID:-1000}
container_gid=${GID:-1000}
chown -R "$container_uid:$container_gid" "agents/$agent/data" 2>/dev/null || true

printf 'Cloning Hermes Agent source (%s @ %s).\n' "$hermes_agent_repo" "$hermes_agent_ref"
git clone "$hermes_agent_repo" "agents/$agent/data/hermes/hermes-agent"
git -C "agents/$agent/data/hermes/hermes-agent" checkout "$hermes_agent_ref"
chown -R "$container_uid:$container_gid" "agents/$agent/data/hermes/hermes-agent" 2>/dev/null || true

cat >"agents/$agent/data/hermes/config.yaml" <<EOF
model:
  provider: openai-codex
  model: gpt-5.3-codex
terminal:
  backend: local
  cwd: /workspace
EOF

cat >"agents/$agent/config/compose.yaml" <<EOF
services:
  $webui_service:
    image: \${HERMES_WEBUI_IMAGE:-$hermes_webui_image}
    container_name: $webui_service
    restart: unless-stopped
    expose:
      - "8787"
    environment:
      HERMES_WEBUI_HOST: 0.0.0.0
      HERMES_WEBUI_PORT: "8787"
      HERMES_WEBUI_PASSWORD: \${$webui_password_var}
      HERMES_HOME: /home/hermeswebui/.hermes
      HERMES_WEBUI_STATE_DIR: /home/hermeswebui/.hermes/webui
      HERMES_WEBUI_DEFAULT_WORKSPACE: /workspace
      HERMES_INFERENCE_PROVIDER: openai-codex
      HERMES_INFERENCE_MODEL: gpt-5.3-codex
      WANTED_UID: \${UID:-1000}
      WANTED_GID: \${GID:-1000}
    volumes:
      - ./agents/$agent/data/hermes:/home/hermeswebui/.hermes
      - ./agents/$agent/data/workspace:/workspace
    networks:
      - tunnel
      - egress
EOF

touch .env
chmod go-rwx .env*
if ! grep -q "^$webui_password_var=" .env; then
  {
    printf '\n# Agent: %s\n' "$agent"
    printf '%s=\n' "$webui_password_var"
  } >>.env
  chmod go-rwx .env*
fi

printf 'Created agent %s.\n' "$agent"
printf 'WebUI URL: https://%s\n' "$webui_host"
printf 'Cloudflare Tunnel service: http://%s:8787\n' "$webui_service"
printf '\nStarting OpenAI Codex login. Open the shown URL, enter the code, and approve the ChatGPT subscription login.\n'

docker run -it --rm \
  -e HERMES_HOME=/opt/data \
  -e HERMES_INFERENCE_PROVIDER=openai-codex \
  -e HERMES_INFERENCE_MODEL=gpt-5.3-codex \
  -e HERMES_UID="$container_uid" \
  -e HERMES_GID="$container_gid" \
  -v "$(pwd)/agents/$agent/data/hermes:/opt/data" \
  -v "$(pwd)/agents/$agent/data/workspace:/workspace" \
  "$hermes_agent_image" auth add openai-codex --type oauth

printf '\nStarting shared tunnel and %s.\n' "$webui_service"
docker compose -f compose.yaml -f "agents/$agent/config/compose.yaml" up -d cloudflared "$webui_service"

printf '\nAgent %s is ready.\n' "$agent"
printf 'Open: https://%s\n' "$webui_host"
