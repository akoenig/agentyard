#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

[ -d agents ] || exit 0

for agent_dir in agents/*; do
  [ -d "$agent_dir" ] || exit 0
  [ -f "$agent_dir/agent.env" ] || continue
  . "$agent_dir/agent.env"
  printf '%s\n' "$NAME"
  printf '  System user: %s\n' "$SYSTEM_USER"
  printf '  WebUI: https://%s\n' "$HOSTNAME"
  printf '  Local service: http://127.0.0.1:%s\n' "$PORT"
  printf '  Home: %s\n' "$AGENT_HOME"
  printf '  Workspace: %s\n' "$WORKSPACE"
done
