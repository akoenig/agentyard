#!/usr/bin/env sh
set -eu

if [ ! -d agents ]; then
  exit 0
fi

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
agent_base_domain=${AGENT_BASE_DOMAIN:-example.com}

for agent_dir in agents/*; do
  [ -d "$agent_dir" ] || exit 0
  agent=$(basename "$agent_dir")
  [ "$agent" = "*" ] && continue
  case "$agent" in
    _*) continue ;;
  esac
  printf '%s\n' "$agent"
  printf '  WebUI: https://%s.%s\n' "$agent" "$agent_base_domain"
  printf '  Cloudflare service: http://%s-hermes-webui:8787\n' "$agent"
  printf '  Cron gateway: %s-hermes-agent\n' "$agent"
  printf '  Docker network: %s-%s\n' "${COMPOSE_PROJECT_NAME:-agents}" "$agent"
done
