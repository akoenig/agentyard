#!/usr/bin/env sh
set -eu

[ "$(id -u)" -eq 0 ] || { printf 'Run this script with sudo/root.\n' >&2; exit 1; }

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
control_user=${AGENTYARD_CONTROL_USER:-minder}
agent_group=${AGENTYARD_AGENT_GROUP:-agentyard-agents}
helper_path=/usr/local/sbin/agentyard-user
cli_path=/usr/local/bin/agentyard
sudoers_path=/etc/sudoers.d/agentyard
required_commands="git curl python3 sudo rg ffmpeg gcc cloudflared unattended-upgrade"

install_packages() {
  missing=""
  for command_name in $required_commands; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      missing="$missing $command_name"
    fi
  done

  if ! python3 -m venv --help >/dev/null 2>&1; then
    missing="$missing python3-venv"
  fi

  [ -n "$missing" ] || return 0

  printf 'Installing required packages:%s\n' "$missing"
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    apt-get install -y ca-certificates curl git python3 python3-venv python3-dev sudo unattended-upgrades ripgrep ffmpeg build-essential libffi-dev

    if ! command -v cloudflared >/dev/null 2>&1; then
      arch=$(dpkg --print-architecture)
      case "$arch" in
        amd64) cloudflared_deb=cloudflared-linux-amd64.deb ;;
        arm64) cloudflared_deb=cloudflared-linux-arm64.deb ;;
        armhf) cloudflared_deb=cloudflared-linux-arm.deb ;;
        i386) cloudflared_deb=cloudflared-linux-386.deb ;;
        *) printf 'Unsupported architecture for cloudflared: %s\n' "$arch" >&2; exit 1 ;;
      esac
      tmp_deb="/tmp/$cloudflared_deb"
      curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/$cloudflared_deb" -o "$tmp_deb"
      apt-get install -y "$tmp_deb"
      rm -f "$tmp_deb"
    fi
  else
    printf 'Agentyard currently supports Ubuntu/Debian hosts with apt-get.\n' >&2
    printf 'Unsupported package manager. Install these packages manually:%s\n' "$missing" >&2
    exit 1
  fi
}

install_packages

if ! id "$control_user" >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash "$control_user"
  passwd -l "$control_user" >/dev/null 2>&1 || true
fi

if ! getent group "$agent_group" >/dev/null 2>&1; then
  groupadd --system "$agent_group"
fi

install -m 0755 "$repo_dir/scripts/agentyard-user-helper" "$helper_path"

cat >"$cli_path" <<EOF
#!/usr/bin/env sh
set -eu

control_user=\${AGENTYARD_CONTROL_USER:-$control_user}
repo_dir=\${AGENTYARD_REPO_DIR:-/home/\$control_user/agentyard}
cli=\$repo_dir/agentyard

[ -x "\$cli" ] || { printf 'Missing Agentyard CLI at %s. Run the remote installer first.\n' "\$cli" >&2; exit 1; }

if [ "\$(id -un)" = "\$control_user" ]; then
  exec "\$cli" "\$@"
fi

if [ "\$(id -u)" -eq 0 ]; then
  exec runuser -u "\$control_user" -- "\$cli" "\$@"
fi

exec sudo -iu "\$control_user" -- "\$cli" "\$@"
EOF
chmod 0755 "$cli_path"

cat >"$sudoers_path" <<EOF
$control_user ALL=(root) NOPASSWD: $helper_path
EOF
chmod 0440 "$sudoers_path"

loginctl enable-linger "$control_user"

printf 'Control-plane user is ready: %s\n' "$control_user"
printf 'Helper installed: %s\n' "$helper_path"
printf 'Global CLI installed: %s\n' "$cli_path"
if [ "${AGENTYARD_SUPPRESS_NEXT_STEPS:-0}" != "1" ]; then
  printf '\nNext steps:\n'
  printf '  sudo -iu %s\n' "$control_user"
  printf '  git clone <this-repo> ~/agentyard\n'
  printf '  agentyard install\n'
fi
