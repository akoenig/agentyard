#!/usr/bin/env sh
set -eu

control_user=${AGENTYARD_CONTROL_USER:-minder}
helper=${AGENTYARD_HELPER:-/usr/local/sbin/agentyard-user}

[ "$(id -u)" -ne 0 ] || { printf 'Run this script as %s, not root.\n' "$control_user" >&2; exit 1; }
[ "$(id -un)" = "$control_user" ] || { printf 'Run this script as %s. Current user: %s\n' "$control_user" "$(id -un)" >&2; exit 1; }

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

if [ ! -f .env ]; then
  cp .env.example .env
  chmod go-rwx .env
fi

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

prompt_if_empty() {
  var_name="$1"
  prompt="$2"
  current_value=$(eval "printf '%s' \"\${$var_name:-}\"")
  if [ -z "$current_value" ]; then
    printf '%s: ' "$prompt"
    IFS= read -r new_value
    printf '%s=%s\n' "$var_name" "$new_value" >>.env
    eval "$var_name=\$new_value"
  fi
}

prompt_if_empty AGENT_BASE_DOMAIN 'Base domain for agent hostnames (example: example.com)'
prompt_if_empty AGENT_BASE_PORT 'First local WebUI port (example: 8787)'

if [ -z "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  printf 'Cloudflare Tunnel token (leave empty to configure cloudflared manually): '
  IFS= read -r tunnel_token
  if [ -n "$tunnel_token" ]; then
    printf 'CLOUDFLARE_TUNNEL_TOKEN=%s\n' "$tunnel_token" >>.env
    CLOUDFLARE_TUNNEL_TOKEN=$tunnel_token
  fi
fi

mkdir -p agents "$HOME/.config/systemd/user" "$HOME/.cloudflared"

[ -x "$helper" ] || { printf 'Missing helper %s. Run sudo scripts/install-control-plane first.\n' "$helper" >&2; exit 1; }
sudo "$helper" enable-linger "$control_user"

if [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  if command -v cloudflared >/dev/null 2>&1; then
    cat >"$HOME/.config/systemd/user/agentyard-cloudflared.service" <<EOF
[Unit]
Description=Agentyard Cloudflare Tunnel
After=network-online.target

[Service]
Type=simple
ExecStart=$(command -v cloudflared) tunnel run --token $CLOUDFLARE_TUNNEL_TOKEN
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now agentyard-cloudflared.service
  else
    printf 'cloudflared is not installed. Install it, then rerun scripts/install to create the tunnel service.\n'
  fi
fi

printf '\nAgentyard control plane is ready. Create an agent with:\n'
printf '  scripts/create-agent hermy\n'
