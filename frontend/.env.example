FRONTEND_COMPOSE_PROJECT_NAME=agent-frontend

# Public URL served by Cloudflare Tunnel.
OPENWEBUI_PUBLIC_URL=https://chat.example.com

# Point OpenWebUI at a private Hermes Agent OpenAI-compatible endpoint.
# Include /v1 so model discovery works.
OPENWEBUI_OPENAI_API_BASE_URL=https://hermy-hermes-api.example.com/v1
OPENWEBUI_OPENAI_API_KEY=change-me-hermes-api-server-key

# Keep disabled unless you intentionally want self-service accounts.
OPENWEBUI_ENABLE_SIGNUP=false

# Create this in Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=change-me
