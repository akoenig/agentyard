FRONTEND_COMPOSE_PROJECT_NAME=agent-frontend

# Public URL served by Cloudflare Tunnel.
OPENWEBUI_PUBLIC_URL=https://chat.example.com

# Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=change-me

# Keep disabled unless you intentionally want self-service accounts.
OPENWEBUI_ENABLE_SIGNUP=false

# Google OAuth for OpenFormation users.
OPENWEBUI_ENABLE_OAUTH_SIGNUP=true
OPENWEBUI_ENABLE_OAUTH_PERSISTENT_CONFIG=false
OPENWEBUI_OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OPENWEBUI_ENABLE_OAUTH_ID_TOKEN_COOKIE=false
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
OPENID_PROVIDER_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_OAUTH_AUTHORIZE_PARAMS={"hd":"openformation.io"}

# Create this in Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=change-me
