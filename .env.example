COMPOSE_PROJECT_NAME=agents

POSTGRES_DB=postgres
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# Generated agent hostnames use <agent>-litellm-api.<domain> and <agent>-hermes-api.<domain>.
AGENT_BASE_DOMAIN=example.com

# Local Caddy entrypoints. Caddy terminates TLS using its internal CA.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
