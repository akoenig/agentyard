POSTGRES_DB=litellm_personal
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# Must start with sk-. Used only for the personal LiteLLM instance administration.
LITELLM_PERSONAL_MASTER_KEY=sk-change-me

# Generate once and do not rotate after storing credentials in the personal LiteLLM database.
LITELLM_PERSONAL_SALT_KEY=sk-change-me-too

# Local Caddy entrypoints. Caddy terminates TLS using its internal CA.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Fill this with the personal LiteLLM virtual key generated for Hermes.
HERMES_PERSONAL_LITELLM_KEY=
