COMPOSE_PROJECT_NAME=agents

POSTGRES_DB=postgres
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# Generated agent hostnames use <agent>-litellm-api.<domain> and <agent>-hermes-api.<domain>.
AGENT_BASE_DOMAIN=example.com

# Local Caddy HTTPS entrypoint. Bind to a specific interface, not 0.0.0.0.
# Use 127.0.0.1 for local-only access, or this host's private IP for a front proxy on another host.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTPS_PORT=443
