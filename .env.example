POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# Must start with sk-. Used only for LiteLLM administration and bootstrapping virtual keys.
LITELLM_MASTER_KEY=sk-change-me

# Generate once and do not rotate after storing LiteLLM credentials.
LITELLM_SALT_KEY=sk-change-me-too

# Bind to a reachable interface because Caddy runs on a different host.
# Restrict access to the Caddy host with a firewall.
HOST_BIND_ADDRESS=0.0.0.0
LITELLM_PORT=4000
HERMES_GATEWAY_PORT=8642

# Fill this with the LiteLLM virtual key generated for Hermes.
HERMES_LITELLM_KEY=
