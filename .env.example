# Generated agent WebUI hostnames use <agent>.<domain>.
AGENT_BASE_DOMAIN=

# First generated agent uses this local WebUI port, then increments by one.
AGENT_BASE_PORT=8787

# Optional token for the Cloudflare Tunnel owned by the minder control-plane user.
# ./agentyard install asks for this if it is empty.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional source pins for every new agent user's WebUI checkout.
HERMES_WEBUI_REPO=https://github.com/nesquena/hermes-webui.git
HERMES_WEBUI_REF=master
